// Eleven tables: three from Auth.js, three for DSA sheet content, one for DSA progress,
// three for System Design content, one for System Design progress.
// Content tables are seeded from data/*.json and never written to at runtime.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Auth.js ─────────────────────────────
// Shape is dictated by @auth/prisma-adapter. Do not rename these fields.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  problems UserProblem[]
  articles SdUserArticle[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ────────────────────────── Sheet content ──────────────────────────

model Phase {
  id       Int     @id
  title    String
  timeline String?

  patterns Pattern[]
}

model Pattern {
  id           Int     @id
  phaseId      Int
  code         String
  title        String
  difficulty   String?
  timeEstimate String?

  phase    Phase     @relation(fields: [phaseId], references: [id])
  problems Problem[]

  @@index([phaseId])
}

/// One row of the sheet. 353 rows.
///
/// `id` is the frozen DOM index from the original legacy/index.html — the same number
/// the old tracker used in localStorage["dsa-task-master-<id>"]. It is the only bridge
/// back to previously ticked problems, so it must never be renumbered. Problems added
/// later start at 1000.
///
/// 35 problems appear under two different patterns; they stay as separate rows, exactly
/// as in the original sheet.
model Problem {
  id         Int        @id
  patternId  Int
  title      String
  lcNumber   Int?
  url        String
  difficulty Difficulty
  role       Role
  hint       String?

  pattern Pattern       @relation(fields: [patternId], references: [id])
  users   UserProblem[]

  @@index([patternId])
}

// ──────────────────────────── Your data ────────────────────────────

/// No row means: not done, not starred, no note, no approaches ticked.
/// `approaches` holds the approach keys ticked for DP and graph problems (see src/lib/approaches.ts);
/// empty for every other problem.
model UserProblem {
  userId     String
  problemId  Int
  done       Boolean  @default(false)
  starred    Boolean  @default(false)
  note       String?  @db.Text
  approaches String[] @default([])
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id])

  @@id([userId, problemId])
  @@index([userId, done])
  @@index([userId, starred])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Role {
  WARMUP
  CORE
  STRETCH
  CONTEST
}

// ─────────────────────── System Design content ───────────────────────
// Seeded from data/system-design.json. Article.id is the curriculum number (1..140)
// and doubles as its display code, so it must never be renumbered.

model SdPart {
  id       Int     @id
  title    String
  subtitle String?

  groups SdGroup[]
}

model SdGroup {
  id     Int    @id
  partId Int
  code   String
  title  String

  part     SdPart      @relation(fields: [partId], references: [id])
  articles SdArticle[]

  @@index([partId])
}

/// One article of the curriculum. 140 rows.
/// `links` is a JSON array of { label, url } — curated outside reading for the topic.
model SdArticle {
  id         Int          @id
  groupId    Int
  code       String
  title      String
  slug       String       @unique
  url        String
  kind       SdKind
  importance SdImportance
  summary    String?
  links      Json         @default("[]")

  group SdGroup         @relation(fields: [groupId], references: [id])
  users SdUserArticle[]

  @@index([groupId])
}

/// No row means: not read, not starred, zero reads, no note.
model SdUserArticle {
  userId     String
  articleId  Int
  done       Boolean   @default(false)
  starred    Boolean   @default(false)
  readCount  Int       @default(0)
  note       String?   @db.Text
  lastReadAt DateTime?
  updatedAt  DateTime  @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  article SdArticle @relation(fields: [articleId], references: [id])

  @@id([userId, articleId])
  @@index([userId, done])
  @@index([userId, starred])
}

enum SdKind {
  FOUNDATION
  LLD
  HLD
  HLD_CASE
  LLD_CASE
  ADVANCED
}

enum SdImportance {
  MUST
  CORE
  EXTRA
}
